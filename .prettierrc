{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 100,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "^react",
    "^next/(.*)$",
    "<THIRD_PARTY_MODULES>",
    "^@domain/(.*)$",
    "^@infrastructure/(.*)$",
    "^@features/(.*)$",
    "^@presentation/(.*)$",
    "^@shared/(.*)$",
    "^@security/(.*)$",
    "^@/(.*)$",
    "^[./]"
  ]
}
